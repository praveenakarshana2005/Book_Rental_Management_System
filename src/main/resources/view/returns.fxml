<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/24.0.1"
            fx:controller="controllers.ReturnsController"
            prefWidth="1000" prefHeight="650"
            style="-fx-background-color: linear-gradient(to bottom right, #2d3436, #000000);">

    <children>

        <!-- MAIN CARD -->
        <VBox layoutX="40" layoutY="30"
              spacing="20"
              prefWidth="920" prefHeight="590"
              style="-fx-background-color: rgba(255,255,255,0.07);
                     -fx-background-radius: 20;
                     -fx-padding: 25;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.35), 20, 0.2, 0, 5);">

            <!-- HEADER -->
            <Label text="Process Returns"
                   style="-fx-text-fill: white;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;" />

            <!-- RENTAL NO SEARCH -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="txtRentalNo"
                           promptText="Rental No"
                           prefWidth="220"
                           style="-fx-background-radius: 7;" />

                <Button text="Load" onAction="#onLoadRental"
                        style="-fx-background-color: #6c5ce7; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 8 20;" />

                <Label fx:id="lblStatus"
                       style="-fx-text-fill: #81ecec; -fx-font-size: 14px;" />
            </HBox>

            <!-- ITEMS TABLE -->
            <TableView fx:id="tableItems" prefHeight="300"
                       style="-fx-background-radius: 12;
                              -fx-background-color: rgba(255,255,255,0.05);
                              -fx-padding: 10;">
                <columns>
                    <TableColumn fx:id="colBook" text="Book" prefWidth="280"/>
                    <TableColumn fx:id="colQty" text="Qty" prefWidth="100"/>
                    <TableColumn fx:id="colReturned" text="Returned" prefWidth="100"/>
                    <TableColumn fx:id="colPending" text="Pending" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- RETURN DATE -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Return Date:"
                       style="-fx-text-fill: white; -fx-font-size: 14px;" />

                <DatePicker fx:id="dpReturnDate"
                            style="-fx-background-radius: 7;" />
            </HBox>

            <!-- COMPLETE RETURN BUTTON -->
            <Button text="Complete Return"
                    prefWidth="240"
                    onAction="#onProcessReturn"
                    style="-fx-background-color: #00cec9;
                           -fx-text-fill: white;
                           -fx-font-size: 16px;
                           -fx-background-radius: 10;
                           -fx-padding: 12 25;" />

            <!-- FINE DISPLAY -->
            <Label fx:id="lblFine"
                   style="-fx-text-fill: #fdcb6e;
                          -fx-font-size: 20px;
                          -fx-font-weight: bold;
                          -fx-padding: 10 0;" />

        </VBox>

    </children>

</AnchorPane>
