<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DashboardController"
            prefWidth="900" prefHeight="550"
            style="-fx-background-color: linear-gradient(to bottom right, #2d3436, #000000);">

    <children>

        <!-- LEFT SIDEBAR MENU -->
        <VBox alignment="TOP_CENTER" spacing="25"
              prefWidth="250" prefHeight="550"
              style="-fx-background-color: rgba(255,255,255,0.08);
                     -fx-background-radius: 0 20 20 0;
                     -fx-padding: 30 10 10 10;">

            <!-- Welcome Label -->
            <Label fx:id="lblWelcome"
                   wrapText="true"
                   style="-fx-text-fill: white;
                          -fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-padding: 0 0 20 0;" />

            <!-- Menu Buttons -->
            <Button text="📚   Books"
                    onAction="#onOpenBooks"
                    prefWidth="200"
                    style="-fx-background-color: #6c5ce7;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-background-radius: 10;" />

            <Button text="👥   Customers"
                    onAction="#onOpenCustomers"
                    prefWidth="200"
                    style="-fx-background-color: #00cec9;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-background-radius: 10;" />


            <Button text="📊   Reports"
                    onAction="#onOpenReports"
                    prefWidth="200"
                    style="-fx-background-color: #0984e3;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-background-radius: 10;" />
        </VBox>


        <!-- MAIN CONTENT AREA -->
        <VBox layoutX="260" layoutY="40" spacing="20">
            <Label text="Dashboard"
                   style="-fx-text-fill: white;
                          -fx-font-size: 30px;
                          -fx-font-weight: bold;" />

            <Label text="Welcome to the Book Rental Management System"
                   style="-fx-text-fill: lightgray;
                          -fx-font-size: 16px;" />

            <!-- Placeholder for charts / stats -->
            <Pane prefWidth="600" prefHeight="350"
                  style="-fx-background-color: rgba(255,255,255,0.05);
                         -fx-background-radius: 15;
                         -fx-border-color: rgba(255,255,255,0.2);
                         -fx-border-radius: 15;">
                <children>
                    <Label text="📊 Reports / Charts Area"
                           layoutX="200" layoutY="150"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 16px;
                                  -fx-opacity: 0.6;" />
                </children>
            </Pane>
        </VBox>

    </children>

</AnchorPane>
